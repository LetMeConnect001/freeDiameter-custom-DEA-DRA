# This file contains the configuration for the app_dea extension of freeDiameter.
#
# app_dea implements a Diameter Edge Agent (DEA): a relay positioned at the
# boundary of a trusted (internal) Diameter network and the outside world
# (roaming partners, interconnect, ...).
#
# Phase 1 of this extension implements TOPOLOGY HIDING: when a request
# originates from one of the configured "internal" realms and is being
# forwarded towards any other realm, its Origin-Host is replaced by a fixed
# pseudonym identity, and any Route-Record AVP added by internal peers is
# stripped and replaced by that same pseudonym. This prevents external peers
# from learning the real hostnames of your internal Diameter nodes (HSS, MME,
# PCRF, ...).
#
# See extensions/app_dea/README for the full architecture and the roadmap of
# features not yet implemented (Session-Id pseudonymization, IMSI/subscriber
# identity mapping, fraud-detection rules, high-availability, observability).

# Lines starting with # are comments and ignored.
# Spaces and newlines are not meaningful, except inside quoted areas.

#########################################################################################

## hidden_identity
# The Diameter Identity to present to external peers instead of the real
# Origin-Host of internal nodes, and instead of the real Route-Record chain.
# This is normally the DEA's own public-facing hostname.
# Topology hiding is DISABLED entirely until this is set.
hidden_identity = "dea-edge1.operator.net";

## internal_realm
# Declare a realm as "internal" / trusted. Topology hiding is applied to a
# request only when its Origin-Realm matches one of these entries AND its
# Destination-Realm does NOT match any of them (i.e. the message is actually
# leaving the internal network). Repeat this directive for each internal realm.
internal_realm = "epc.mnc001.mcc001.3gppnetwork.org";
#internal_realm = "internal.operator.net";

## hide_origin_host
# Enable/disable masking of the Origin-Host AVP. Default: 1 (enabled).
#hide_origin_host = 1;

## hide_route_record
# Enable/disable stripping and replacement of Route-Record AVPs. Default: 1 (enabled).
#hide_route_record = 1;

## hide_session_id
# Enable/disable Session-Id pseudonymization: for the same internal -> external crossing
# defined by internal_realm above, the Session-Id AVP is replaced with a generated pseudonym
# for the lifetime of the whole Diameter session (which spans many request/answer
# transactions, not just one), and rewritten back and forth consistently on every subsequent
# message of that session, in both directions.
#
# Default: 0 (DISABLED). This is deliberately opt-in: RFC 6733 (Diameter base protocol)
# expects relay/proxy agents to NOT modify Session-Id -- it must stay constant end-to-end for
# session correlation and CDR reconciliation between operators. Enabling this is a conscious
# deviation from that standard behavior, made only for topology-hiding privacy purposes (as
# documented for DEA nodes in GSMA IR.88). See extensions/app_dea/README before enabling it.
#hide_session_id = 0;

## session_id_lifetime
# How many seconds of inactivity before a Session-Id pairing (real <-> masked) expires and is
# forgotten. A session that goes quiet for longer than this and then sends another message will
# simply get a brand new masked pseudonym (not an error, just a fresh mapping). Default: 86400
# (24h). Only meaningful if hide_session_id is enabled.
#session_id_lifetime = 86400;

#########################################################################################
